#!/usr/bin/env bash
# Rendered harness copies must match the canon, and the runtime's own tests
# must pass. Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
scripts/skills/sync-claude-skills.sh --check
scripts/agents/sync-agents.sh --check
for t in .agents/skills/task-orchestrator/scripts/tests/*.sh; do "$t" >/dev/null; done
